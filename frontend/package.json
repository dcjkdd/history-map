{
  "name": "history-map-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "validate:data": "node scripts/validate-data.ts",
    "audit:content": "node scripts/audit-content-release.ts",
    "verify:phase2-03-content": "node scripts/verify-phase2-03-content.ts",
    "verify:terrain-assets": "node scripts/verify-terrain-assets.ts public/terrain/phase2-02",
    "verify:terrain-bundle": "node scripts/verify-terrain-assets.ts dist/terrain/phase2-02",
    "verify:worker-bundle": "node scripts/verify-worker-bundle.ts",
    "test": "vitest run",
    "build": "npm run typecheck && npm run validate:data && npm run verify:phase2-03-content && npm run verify:terrain-assets && vite build",
    "check": "npm run typecheck && npm run validate:data && npm run audit:content && npm run verify:phase2-03-content && npm run test && npm run build && npm run verify:worker-bundle && npm run verify:terrain-bundle"
  },
  "dependencies": {
    "maplibre-gl": "6.0.0",
    "pinia": "4.0.2",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
